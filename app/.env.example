# --- App ---
PORT=3000

# --- RDS (PostgreSQL) ---
# Point these at your RDS endpoint. Never commit a real .env file.
DB_HOST=your-rds-endpoint.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=inventorydb
DB_USER=postgres
DB_PASSWORD=changeme

# --- S3 ---
S3_BUCKET_NAME=your-product-images-bucket
AWS_REGION=us-east-1
# On EC2, prefer an IAM Instance Role over static keys (leave these blank if using a role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
